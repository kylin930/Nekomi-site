---
import "mdui/mdui.css";
import "../styles/global.css";
import Icon from "../components/Icon.astro";
import Logo from "../components/Logo.astro";
import { settings, withBase, absolute } from "../../website.config.mjs";
interface Props {
  title?: string;
  description?: string;
  wide?: boolean;
  noindex?: boolean;
}
const {
  title,
  description = settings.description,
  noindex = false,
} = Astro.props;
const fullTitle = title
  ? `${title} · Nekomi`
  : "Nekomi · 为文字留一处舒适的空间";
const canonical = settings.url
  ? new URL(Astro.url.pathname, settings.url).href
  : undefined;
const nav = [
  ["", "首页"],
  ["features/", "特性"],
  ["demo/", "演示"],
  ["docs/", "文档"],
  ["changelog/", "更新日志"],
];
const active = (path: string) =>
  path
    ? Astro.url.pathname.startsWith(withBase(path))
    : Astro.url.pathname === withBase();
---

<!doctype html>
<html lang="zh-CN" class="mdui-theme-light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta
      name="robots"
      content={
        !settings.url || !settings.indexing || noindex
          ? "noindex, follow"
          : "index, follow"
      }
    />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:site_name" content="Nekomi" />
    {canonical && <meta property="og:url" content={canonical} />}
    {settings.url && (
      <>
        <meta
          property="og:image"
          content={absolute("screenshots/p30-default-home-light-1440.png")}
        />
        <meta
          property="og:image:alt"
          content="Nekomi 默认浅色桌面首页的真实截图"
        />
      </>
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href={withBase("favicon.svg")} />
    <script is:inline>
      (() => {
        let mode = "system";
        try {
          mode = localStorage.getItem("nekomi-website-theme") || mode;
        } catch {}
        const dark =
          mode === "dark" ||
          (mode === "system" &&
            matchMedia("(prefers-color-scheme: dark)").matches);
        document.documentElement.dataset.mode = mode;
        document.documentElement.dataset.theme = dark ? "dark" : "light";
        document.documentElement.className =
          "mdui-theme-" + (dark ? "dark" : "light");
      })();
    </script>
    {canonical && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify({
          "@context": "https://schema.org",
          "@type": "WebSite",
          name: settings.name,
          url: absolute(),
          description: settings.description,
          inLanguage: "zh-CN",
        }).replace(/</g, "\u003c")}
      />
    )}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      跳到主要内容
    </a>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href={withBase()} aria-label="Nekomi 首页">
          <Logo />
        </a>
        <nav class="desktop-nav" aria-label="主导航">
          {nav.map(([path, label]) => (
            <a
              href={withBase(path)}
              aria-current={active(path) ? "page" : undefined}
            >
              {label}
            </a>
          ))}
        </nav>
        <div class="header-tools">
          <button class="icon-button" data-open-search aria-label="搜索文档">
            <Icon name="search" />
            <kbd>⌘ K</kbd>
          </button>
          <label class="theme-select">
            <Icon name="sun" />
            <span class="sr-only">配色模式</span>
            <select aria-label="配色模式" data-theme-select>
              <option value="system">跟随系统</option>
              <option value="light">浅色</option>
              <option value="dark">深色</option>
            </select>
          </label>
          <a
            class="github-link"
            href={settings.github}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub 主题仓库"
          >
            <Icon name="github" />
          </a>
          <button
            class="icon-button mobile-toggle"
            aria-label="打开导航菜单"
            data-menu-toggle
            aria-expanded="false"
            aria-controls="mobile-menu"
          >
            <Icon name="menu" />
          </button>
        </div>
      </div>
      <nav
        id="mobile-menu"
        class="mobile-menu"
        aria-label="移动端主导航"
        hidden
      >
        {nav.map(([path, label]) => (
          <a
            href={withBase(path)}
            aria-current={active(path) ? "page" : undefined}
          >
            {label}
          </a>
        ))}
        <a href={withBase("faq/")}>常见问题</a>
        <a href={settings.github}>GitHub ↗</a>
      </nav>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer wrap">
      <div>
        <a class="brand" href={withBase()}>
          <Logo />
        </a>
        <p>写下日常，也留住灵感。</p>
        <small>
          © {new Date().getFullYear()} Nekomi contributors · MIT License
        </small>
      </div>
      <nav aria-label="页脚导航">
        <a href={withBase("docs/getting-started/")}>开始使用</a>
        <a href={withBase("faq/")}>常见问题</a>
        <a href={settings.github}>GitHub ↗</a>
        <a href={withBase("NEKOMI-LICENSE.txt")}>素材与主题许可</a>
      </nav>
      <span class="footer-note">
        Built with Astro & MDUI 2<br />
        静态、轻盈，属于你。
      </span>
    </footer>
    <button
      class="back-top icon-button"
      data-back-top
      aria-label="返回顶部"
      hidden
    >
      <Icon name="up" />
    </button>
    <dialog
      class="search-dialog"
      id="doc-search"
      aria-labelledby="search-title"
      data-index={withBase("search-index.json")}
    >
      <div class="search-top">
        <Icon name="search" />
        <label for="search-input" id="search-title" class="sr-only">
          搜索文档
        </label>
        <input
          id="search-input"
          type="search"
          placeholder="搜索文档，例如：壁纸、评论、部署"
          autocomplete="off"
        />
        <button class="icon-button" data-close-search aria-label="关闭搜索">
          <Icon name="close" />
        </button>
      </div>
      <p id="search-status" role="status">
        输入关键词，查找指南和配置。
      </p>
      <div id="search-results"></div>
      <div class="search-bottom">
        <span>↑ ↓ 选择 · Enter 打开</span>
        <span>Esc 关闭</span>
      </div>
    </dialog>
    <noscript>
      <p class="wrap">
        文档搜索需要 JavaScript；可通过<a href={withBase("docs/")}>文档目录</a>
        浏览全部内容。
      </p>
    </noscript>
    <script>
      import "../scripts/site.ts";
    </script>
  </body>
</html>
