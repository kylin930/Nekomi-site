---
import Base from "../../layouts/Base.astro";
import { faqs } from "../../data/faq.mjs";
import { withBase, settings } from "../../../website.config.mjs";
---

<Base
  title="常见问题"
  description="Nekomi 的服务器要求、GitHub Pages、外观配置、文章迁移、评论后端与主题升级常见问题。"
>
  <div class="wrap narrow">
    <header class="page-heading">
      <span class="eyebrow">NEKOMI / 常见问题</span>
      <h1>开始之前，你可能想知道。</h1>
      <p>关于搭建、配置与长期维护的一些实际问题。</p>
    </header>
    <div class="faq-list">
      {faqs.map(([question, answer, doc], i) => (
        <details id={`question-${i + 1}`}>
          <summary>
            <span>{question}</span>
            <span class="faq-plus" aria-hidden="true">
              +
            </span>
          </summary>
          <div>
            <p>{answer}</p>
            <a class="text-link" href={withBase(`docs/${doc}/`)}>
              阅读相关文档 →
            </a>
          </div>
        </details>
      ))}
    </div>
    <p class="source-note">
      还有其他问题？
      <a href={`${settings.github}/issues`}>到 GitHub Issues 交流 ↗</a>
    </p>
  </div>
</Base>
