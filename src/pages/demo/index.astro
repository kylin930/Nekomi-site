---
import Base from "../../layouts/Base.astro";
import ColorLab from "../../components/ColorLab.astro";
import Showcase from "../../components/Showcase.astro";
import Icon from "../../components/Icon.astro";
import { snapshot } from "../../lib/content.mjs";
import { settings, withBase } from "../../../website.config.mjs";
---

<Base
  title="演示"
  description="三种设计预设，自由定义你的配色。查看真实主题截图，使用同源隔离的 MDUI 配色实时预览。"
>
  <div class="wrap">
    <header class="page-heading">
      <span class="eyebrow">NEKOMI / 实际模样</span>
      <h1>设计预设之外，还有你的颜色。</h1>
      <p>
        Default、Fresh、Minimal
        提供不同的设计起点，主色与辅助色都可以自由配置。先看看真实截图，再试一试自己的配色。
      </p>
      {settings.demoUrl ? (
        <a
          class="button filled"
          href={settings.demoUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          打开在线 Demo <Icon name="external" />
        </a>
      ) : (
        <p class="subtle-note">目前提供真实截图展示，在线 Demo 尚未配置。</p>
      )}
    </header>
    <nav class="demo-jump-links" aria-label="演示区域">
      <a href="#official-presets">查看官方设计预设</a>
      <a href="#custom-colors">试用自定义配色 ↓</a>
    </nav>
    <section
      id="official-presets"
      class="section"
      aria-labelledby="presets-title"
    >
      <header class="demo-block-heading">
        <h2 id="presets-title">官方设计预设</h2>
        <p>
          以下是主题实际构建的截图。预设同时影响默认配色、圆角或字体等设计参数；显式设置
          color / secondary 后，三种预设都能使用自己的颜色。
        </p>
      </header>
      <Showcase />
      <div class="preset-descriptions">
        <article>
          <i class="preset-dot purple"></i>
          <h3>Default</h3>
          <p>
            默认以 Nekomi
            紫色为起点，保留原有形状与标题风格。主色和辅助色均可覆盖。
          </p>
        </article>
        <article>
          <i class="preset-dot green"></i>
          <h3>Fresh</h3>
          <p>
            默认使用柔和青绿与辅助色，卡片圆角为
            24px。自定义配色时仍可保留这套形状。
          </p>
        </article>
        <article>
          <i class="preset-dot neutral"></i>
          <h3>Minimal</h3>
          <p>
            降低首篇染色，采用 12px 卡片圆角与简洁标题字体。Minimal
            同样支持自定义主色。
          </p>
        </article>
      </div>

      <p class="source-note">
        截图来自 Nekomi 主题仓库的实际构建。
        <a
          href={`${snapshot.repository}/blob/${snapshot.commit}/screenshots/P30.md`}
        >
          首页截图来源
        </a>{" "}
        ·{" "}
        <a
          href={`${snapshot.repository}/blob/${snapshot.commit}/screenshots/P31.md`}
        >
          阅读截图来源
        </a>
        。同步提交{" "}
        <a href={`${snapshot.repository}/commit/${snapshot.commit}`}>
          {snapshot.commit.slice(0, 7)}
        </a>
        。
      </p>
    </section>
    <ColorLab />
    <section class="section">
      <div class="section-heading">
        <div>
          <span class="eyebrow">不止首页</span>
          <h2>走进一篇文章。</h2>
        </div>
        <a class="text-link" href={withBase("docs/markdown/")}>
          阅读功能说明 <Icon name="arrow" />
        </a>
      </div>
      <div class="screenshot-gallery">
        {[
          ["reader", "文章阅读"],
          ["callouts", "语义提示块"],
          ["tabs", "内容 Tabs 与代码"],
          ["math", "KaTeX 数学公式"],
          ["diagrams", "Mermaid 图表"],
        ].map(([name, title]) => (
          <figure>
            <a
              href={withBase(`screenshots/p31-${name}-light-1440.png`)}
              target="_blank"
              rel="noopener noreferrer"
            >
              <img
                src={withBase(`screenshots/p31-${name}-light-1440.png`)}
                alt={`Nekomi ${title}真实截图`}
                width="1440"
                height="900"
                loading="lazy"
              />
            </a>
            <figcaption>
              {title}
              <span>点击查看原图 ↗</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </section>
  </div>
</Base>
